# -----------------------------------------------------------------------------
# ResilientPH - Environment Variables Template
# Copy this file to .env.local and populate with your credentials.
# Do NOT commit .env.local to version control.
#
# Vercel deployment:
#   1. Add every variable below in Project Settings > Environment Variables.
#   2. In Supabase > Authentication > URL Configuration, set the Site URL to your
#      Vercel domain and add https://<your-app>.vercel.app/** to Redirect URLs.
#   3. Rollback: Vercel dashboard > Deployments > previous deployment > "Instant Rollback"
#      (or revert the env var change and redeploy).
# -----------------------------------------------------------------------------

# Google AI API Key (For LangChain Gemini integrations)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Supabase Configurations (Client & Server keys)
NEXT_PUBLIC_SUPABASE_URL=https://your_supabase_project_ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Centralized Site URL configuration
# On Vercel this is optional (falls back to the Vercel domain); set it for custom domains.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron protection (Optional). When set, Vercel Cron sends it as a Bearer token and
# privileged force-refreshes (e.g. /api/pagasa/typhoon?force=true) require it.
CRON_SECRET=generate_a_long_random_string

# Upstash Redis Configuration (Optional, for persistent serverless rate limiting)
UPSTASH_REDIS_REST_URL=https://your_upstash_redis_rest_url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Centralized Map Tile API Key (Optional CARTO basemaps API key from carto.com/basemaps/apikey)
NEXT_PUBLIC_CARTO_API_KEY=your_carto_api_key_here
